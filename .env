OMG_CONTENT_ENABLED=true
OMG_CLAMAV_TIMEOUT = 6
OMG_CONTENT_LURE_RULES=true
OMG_CONTENT_OCR_MODE=when_needed
OMG_CONTENT_OCR_REQUIRED=false
OMG_CONTENT_IMAGE_POLICY=ocr_only
